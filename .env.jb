# JB local development resolver refs for core-bjesuiter-de.
# Do not put DEV_ENV=jb in this file; keep the selector in gitignored .env.local.
# Exported env var names intentionally remain unchanged.

CORE_DATABASE_URL=exec("security find-generic-password -s varlock -a \"core-bjesuiter-de:jb:CORE_DATABASE_URL\" -w")
TURSO_AUTH_TOKEN=exec("security find-generic-password -s varlock -a \"core-bjesuiter-de:jb:TURSO_AUTH_TOKEN\" -w")
CORE_ROOT_USER_EMAIL=exec("security find-generic-password -s varlock -a \"core-bjesuiter-de:jb:CORE_ROOT_USER_EMAIL\" -w")
CORE_ROOT_USER_LABEL=exec("security find-generic-password -s varlock -a \"core-bjesuiter-de:jb:CORE_ROOT_USER_LABEL\" -w")
CORE_ROOT_USER_PASSWORD=exec("security find-generic-password -s varlock -a \"core-bjesuiter-de:jb:CORE_ROOT_USER_PASSWORD\" -w")
LOCAL_DRIZZLE_STUDIO_DB_URL=exec("security find-generic-password -s varlock -a \"core-bjesuiter-de:jb:LOCAL_DRIZZLE_STUDIO_DB_URL\" -w")
LOCAL_DRIZZLE_STUDIO_DB_AUTH=exec("security find-generic-password -s varlock -a \"core-bjesuiter-de:jb:LOCAL_DRIZZLE_STUDIO_DB_AUTH\" -w")
