# JB local development resolver refs for core-bjesuiter-de.
# Do not put DEV_ENV=jb in this file; keep the selector in gitignored .env.local.
# Exported env var names intentionally remain unchanged.

CORE_DATABASE_URL=keychain(service="varlock", account="core-bjesuiter-de:jb:CORE_DATABASE_URL")
TURSO_AUTH_TOKEN=keychain(service="varlock", account="core-bjesuiter-de:jb:TURSO_AUTH_TOKEN")
CORE_ROOT_USER_EMAIL=keychain(service="varlock", account="core-bjesuiter-de:jb:CORE_ROOT_USER_EMAIL")
CORE_ROOT_USER_LABEL=keychain(service="varlock", account="core-bjesuiter-de:jb:CORE_ROOT_USER_LABEL")
CORE_ROOT_USER_PASSWORD=keychain(service="varlock", account="core-bjesuiter-de:jb:CORE_ROOT_USER_PASSWORD")
LOCAL_DRIZZLE_STUDIO_DB_URL=keychain(service="varlock", account="core-bjesuiter-de:jb:LOCAL_DRIZZLE_STUDIO_DB_URL")
LOCAL_DRIZZLE_STUDIO_DB_AUTH=keychain(service="varlock", account="core-bjesuiter-de:jb:LOCAL_DRIZZLE_STUDIO_DB_AUTH")
