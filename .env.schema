# @defaultSensitive=false @defaultRequired=infer @currentEnv=$DEV_ENV
# ---

# Local developer profile selector. Keep the selector in gitignored .env.local,
# for example DEV_ENV=jb, so committed per-profile resolver files stay portable.
# @type=enum(development, jb, codikyo, github_actions, deno_deploy) @sensitive=false
DEV_ENV=development

# Runtime stage. Deno Deploy and CI should provide this from their environment.
# @type=enum(local, github_actions, deno_deploy) @sensitive=false
STAGE=local

# Turso/libSQL database URL for the active stage.
# Local SQLite is currently not used because Drizzle + Deno choose @libsql/client/web,
# which cannot connect to file URLs. Local development uses a Turso dev DB instead.
# Example local file URL if that limitation is resolved later:
# CORE_DATABASE_URL="./runtime/data/db.sqlite"
# @required @type=url(startsWith=libsql://) @sensitive=false
CORE_DATABASE_URL=

# Turso/libSQL auth token for the active stage.
# Local profile source: committed .env.<DEV_ENV> resolver refs, e.g. .env.jb.
# @required @sensitive @type=string(minLength=1)
TURSO_AUTH_TOKEN=

# Email address for the root user bootstrap route.
# @required @type=string @sensitive=false @example=jb@example.com
CORE_ROOT_USER_EMAIL=

# Display label for the root user bootstrap route.
# @required @type=string @sensitive=false @example=JB
CORE_ROOT_USER_LABEL=

# Password for the root user bootstrap route.
# Local profile source: committed .env.<DEV_ENV> resolver refs, e.g. .env.jb.
# @required @sensitive @type=string(minLength=8)
CORE_ROOT_USER_PASSWORD=

# Database URL used by the production Drizzle Studio local helper.
# @type=url(startsWith=libsql://) @sensitive=false
LOCAL_DRIZZLE_STUDIO_DB_URL=

# Auth token used by the production Drizzle Studio local helper.
# Local profile source: committed .env.<DEV_ENV> resolver refs, e.g. .env.jb.
# @sensitive @type=string(minLength=1)
LOCAL_DRIZZLE_STUDIO_DB_AUTH=

# Deno/Rust backtrace behavior for local debugging.
# Optional Deno telemetry flag for local debugging:
# OTEL_DENO=true
# @type=string @sensitive=false
RUST_BACKTRACE=1
