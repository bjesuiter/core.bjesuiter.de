# @defaultSensitive=false @defaultRequired=infer @currentEnv=$STAGE
# ---
#
# Varlock 1.7.2 keychain(prompt) only customizes the picker with the exported env var name.
# It cannot set a project-aware picker heading such as "Select Keychain Item for <ENV_VAR_NAME> in core-bjesuiter-de".
# Local macOS secrets therefore use explicit project-scoped Keychain references:
# service="varlock", account="core-bjesuiter-de:<ENV_VAR_NAME>".

# Runtime stage. Deno Deploy and CI should provide this from their environment.
# @type=enum(local, github_actions, deno_deploy) @sensitive=false
STAGE=local

# Turso/libSQL database URL for the active stage.
# @required @type=url(startsWith=libsql://) @sensitive=false
CORE_DATABASE_URL=

# Turso/libSQL auth token for the active stage.
# Local dev macOS Keychain source: service="varlock", account="core-bjesuiter-de:TURSO_AUTH_TOKEN".
# Provenance: env=TURSO_AUTH_TOKEN, project=core-bjesuiter-de, repo=/Users/bjesuiter/Develop/bjesuiter/core.bjesuiter.de, local_dev_secret=true.
# @required @sensitive @type=string(minLength=1)
TURSO_AUTH_TOKEN=keychain(service="varlock", account="core-bjesuiter-de:TURSO_AUTH_TOKEN")

# Email address for the root user bootstrap route.
# @required @type=string @sensitive=false @example=jb@example.com
CORE_ROOT_USER_EMAIL=

# Display label for the root user bootstrap route.
# @required @type=string @sensitive=false @example=JB
CORE_ROOT_USER_LABEL=

# Password for the root user bootstrap route.
# Local dev macOS Keychain source: service="varlock", account="core-bjesuiter-de:CORE_ROOT_USER_PASSWORD".
# Provenance: env=CORE_ROOT_USER_PASSWORD, project=core-bjesuiter-de, repo=/Users/bjesuiter/Develop/bjesuiter/core.bjesuiter.de, local_dev_secret=true.
# @required @sensitive @type=string(minLength=8)
CORE_ROOT_USER_PASSWORD=keychain(service="varlock", account="core-bjesuiter-de:CORE_ROOT_USER_PASSWORD")

# Database URL used by the production Drizzle Studio local helper.
# @required @type=url(startsWith=libsql://) @sensitive=false
LOCAL_DRIZZLE_STUDIO_DB_URL=

# Auth token used by the production Drizzle Studio local helper.
# Local dev macOS Keychain source: service="varlock", account="core-bjesuiter-de:LOCAL_DRIZZLE_STUDIO_DB_AUTH".
# Provenance: env=LOCAL_DRIZZLE_STUDIO_DB_AUTH, project=core-bjesuiter-de, repo=/Users/bjesuiter/Develop/bjesuiter/core.bjesuiter.de, local_dev_secret=true.
# @required @sensitive @type=string(minLength=1)
LOCAL_DRIZZLE_STUDIO_DB_AUTH=keychain(service="varlock", account="core-bjesuiter-de:LOCAL_DRIZZLE_STUDIO_DB_AUTH")

# Deno/Rust backtrace behavior for local debugging.
# @type=string @sensitive=false
RUST_BACKTRACE=1
