# Shared local dev values for core-bjesuiter-de.
# Values are decrypted from the committed SOPS/age file at runtime.
# Exported env var names intentionally remain unchanged.

CORE_DATABASE_URL=exec("sops --decrypt --extract '[\"CORE_DATABASE_URL\"]' secrets/shared.env.enc.yaml")
TURSO_AUTH_TOKEN=exec("sops --decrypt --extract '[\"TURSO_AUTH_TOKEN\"]' secrets/shared.env.enc.yaml")
CORE_ROOT_USER_EMAIL=exec("sops --decrypt --extract '[\"CORE_ROOT_USER_EMAIL\"]' secrets/shared.env.enc.yaml")
CORE_ROOT_USER_LABEL=exec("sops --decrypt --extract '[\"CORE_ROOT_USER_LABEL\"]' secrets/shared.env.enc.yaml")
CORE_ROOT_USER_PASSWORD=exec("sops --decrypt --extract '[\"CORE_ROOT_USER_PASSWORD\"]' secrets/shared.env.enc.yaml")
LOCAL_DRIZZLE_STUDIO_DB_URL=exec("sops --decrypt --extract '[\"LOCAL_DRIZZLE_STUDIO_DB_URL\"]' secrets/shared.env.enc.yaml")
LOCAL_DRIZZLE_STUDIO_DB_AUTH=exec("sops --decrypt --extract '[\"LOCAL_DRIZZLE_STUDIO_DB_AUTH\"]' secrets/shared.env.enc.yaml")
